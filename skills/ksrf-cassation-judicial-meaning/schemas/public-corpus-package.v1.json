{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ksrf-cassation-judicial-meaning/public-corpus-package.v1.json",
  "title": "Portable public cassation corpus package",
  "type": "object",
  "required": [
    "schema_version",
    "export_id",
    "exported_at",
    "corpus_evidence_digest",
    "public_only",
    "run",
    "seeds",
    "snapshots",
    "observations",
    "indexed_texts",
    "run_pins",
    "funnel",
    "treatments",
    "limitations",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "export_id": {
      "type": "string",
      "pattern": "^public-corpus-export-sha256:[0-9a-f]{64}$"
    },
    "exported_at": {"type": "string", "format": "date-time"},
    "corpus_evidence_digest": {
      "type": "string",
      "pattern": "^portable-evidence-sha256:[0-9a-f]{64}$"
    },
    "public_only": {"const": true},
    "run": {"$ref": "#/$defs/run_pin"},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/seed"}
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/snapshot"}
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    },
    "indexed_texts": {
      "type": "array",
      "items": {"$ref": "#/$defs/indexed_text"}
    },
    "run_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/run_pin"}
    },
    "funnel": {"$ref": "#/$defs/funnel"},
    "treatments": {
      "type": "array",
      "items": {"$ref": "#/$defs/treatment"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullable_string": {
      "type": ["string", "null"]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snapshot-sha256:[0-9a-f]{64}$"
    },
    "run_pin": {
      "type": "object",
      "required": ["run_id", "pin_digest", "snapshot_ids", "created_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "pin_digest": {
          "type": "string",
          "pattern": "^evidence-sha256:[0-9a-f]{64}$"
        },
        "snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/snapshot_id"}
        },
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "object",
      "required": ["seed_id", "url", "role", "public"],
      "properties": {
        "seed_id": {
          "type": "string",
          "pattern": "^seed-sha256:[0-9a-f]{64}$"
        },
        "url": {"type": "string", "format": "uri", "minLength": 1},
        "role": {
          "type": "string",
          "enum": [
            "official_enumerator_observation",
            "official_user_seed",
            "official_authority_seed",
            "discovery_only"
          ]
        },
        "public": {"const": true}
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "raw_sha256", "byte_length", "object_path"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/snapshot_id"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "object_path": {
          "type": "string",
          "pattern": "^objects/[0-9a-f]{64}\\.bin$"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_id",
        "seed_id",
        "snapshot_id",
        "fetched_at",
        "content_type",
        "parser_manifest"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^observation-sha256:[0-9a-f]{64}$"
        },
        "seed_id": {
          "type": "string",
          "pattern": "^seed-sha256:[0-9a-f]{64}$"
        },
        "snapshot_id": {"$ref": "#/$defs/snapshot_id"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "content_type": {"$ref": "#/$defs/nullable_string"},
        "parser_manifest": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "indexed_text": {
      "type": "object",
      "required": [
        "snapshot_id",
        "text_hash",
        "text",
        "document_id",
        "chain_candidate_id",
        "query_lane"
      ],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/snapshot_id"},
        "text_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "text": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "chain_candidate_id": {"type": "string", "minLength": 1},
        "query_lane": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "funnel_status": {
      "type": "string",
      "enum": [
        "enumerated",
        "card",
        "document_link",
        "payload_validated",
        "full_text_extracted",
        "indexed",
        "screened",
        "coded",
        "approved_independent_chain",
        "blocked",
        "retryable_error",
        "official_page_no_text",
        "unextractable",
        "ocr_pending",
        "human_verification_pending"
      ]
    },
    "funnel_state": {
      "type": "object",
      "required": [
        "chain_id",
        "status",
        "snapshot_id",
        "reason",
        "source_role",
        "court_id",
        "period_id",
        "enumerator_id",
        "updated_at"
      ],
      "properties": {
        "chain_id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/funnel_status"},
        "snapshot_id": {
          "oneOf": [
            {"$ref": "#/$defs/snapshot_id"},
            {"type": "null"}
          ]
        },
        "reason": {"$ref": "#/$defs/nullable_string"},
        "source_role": {"$ref": "#/$defs/nullable_string"},
        "court_id": {"$ref": "#/$defs/nullable_string"},
        "period_id": {"$ref": "#/$defs/nullable_string"},
        "enumerator_id": {"$ref": "#/$defs/nullable_string"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "funnel_event": {
      "type": "object",
      "required": [
        "event_id",
        "chain_id",
        "status",
        "snapshot_id",
        "reason",
        "source_role",
        "court_id",
        "period_id",
        "enumerator_id",
        "event_at",
        "ordinal"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^funnel-event-sha256:[0-9a-f]{64}$"
        },
        "chain_id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/funnel_status"},
        "snapshot_id": {
          "oneOf": [
            {"$ref": "#/$defs/snapshot_id"},
            {"type": "null"}
          ]
        },
        "reason": {"$ref": "#/$defs/nullable_string"},
        "source_role": {"$ref": "#/$defs/nullable_string"},
        "court_id": {"$ref": "#/$defs/nullable_string"},
        "period_id": {"$ref": "#/$defs/nullable_string"},
        "enumerator_id": {"$ref": "#/$defs/nullable_string"},
        "event_at": {"type": "string", "format": "date-time"},
        "ordinal": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "funnel": {
      "type": "object",
      "required": ["states", "events"],
      "properties": {
        "states": {
          "type": "array",
          "items": {"$ref": "#/$defs/funnel_state"}
        },
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/funnel_event"}
        }
      },
      "additionalProperties": false
    },
    "treatment_history": {
      "type": "object",
      "required": [
        "history_id",
        "event_type",
        "reviewer",
        "payload",
        "event_at",
        "ordinal"
      ],
      "properties": {
        "history_id": {
          "type": "string",
          "pattern": "^treatment-history-sha256:[0-9a-f]{64}$"
        },
        "event_type": {
          "type": "string",
          "enum": ["candidate_created", "verified", "rejected"]
        },
        "reviewer": {"$ref": "#/$defs/nullable_string"},
        "payload": {"type": "object"},
        "event_at": {"type": "string", "format": "date-time"},
        "ordinal": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "required": [
        "treatment_id",
        "source_chain_id",
        "source_court_id",
        "target_authority_id",
        "target_kind",
        "target_identity",
        "treatment_type",
        "snapshot_id",
        "supersedes_treatment_id",
        "status",
        "reviewer",
        "quote",
        "locator",
        "speaker",
        "created_at",
        "reviewed_at",
        "review_history"
      ],
      "properties": {
        "treatment_id": {
          "type": "string",
          "pattern": "^treatment-sha256:[0-9a-f]{64}$"
        },
        "source_chain_id": {"type": "string", "minLength": 1},
        "source_court_id": {"$ref": "#/$defs/nullable_string"},
        "target_authority_id": {"type": "string", "minLength": 1},
        "target_kind": {"$ref": "#/$defs/nullable_string"},
        "target_identity": {
          "oneOf": [
            {"type": "object", "minProperties": 1},
            {"type": "null"}
          ]
        },
        "treatment_type": {
          "type": "string",
          "enum": [
            "applies",
            "follows",
            "distinguishes",
            "limits",
            "rejects",
            "supersedes",
            "unclear",
            "does_not_reach"
          ]
        },
        "snapshot_id": {"$ref": "#/$defs/snapshot_id"},
        "supersedes_treatment_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^treatment-sha256:[0-9a-f]{64}$"
            },
            {"type": "null"}
          ]
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "verified", "rejected"]
        },
        "reviewer": {"$ref": "#/$defs/nullable_string"},
        "quote": {"$ref": "#/$defs/nullable_string"},
        "locator": {"$ref": "#/$defs/nullable_string"},
        "speaker": {"$ref": "#/$defs/nullable_string"},
        "created_at": {"type": "string", "format": "date-time"},
        "reviewed_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "review_history": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/treatment_history"}
        }
      },
      "additionalProperties": false
    }
  }
}
