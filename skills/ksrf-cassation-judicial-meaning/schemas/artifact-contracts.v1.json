    "page_coverage": ["task_id", "court_code", "hearing_date", "requested_url", "status", "attempts", "navigation_state"],
    "case_chain": ["chain_id", "document_ids", "link_status", "review_status"],
    "coding_decision": ["chain_id", "label", "speaker", "quote", "norm_edition_id", "reasoning_to_outcome", "reading_family", "relation", "human_review"],
    "adverse_review": ["run_id", "lanes", "completed", "reviewer", "limitations"],
    "analysis": ["status", "screening_resolution_complete", "reading_family_counts", "reading_family_by_year", "reading_family_by_stratum", "interpretive_event_findings", "temporal_analysis_complete", "temporal_unassigned_chain_ids", "denominator_scope"],
