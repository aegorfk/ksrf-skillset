{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ksrf-cassation-judicial-meaning/research-plan/1.0",
  "title": "Evidence Acquisition Plan",
  "type": "object",
  "required": [
    "schema_version", "research_questions", "norm_editions", "population",
    "query_lanes", "inclusion_rules", "exclusion_rules", "materiality_rule",
    "adverse_review", "contradiction_rule", "coverage_expectation",
    "maximum_claim_if_incomplete", "approved_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "research_questions": {"type": "array", "minItems": 1},
    "norm_editions": {"type": "array", "minItems": 1},
    "population": {"type": "object"},
    "temporal_strata": {
      "type": "array",
      "anyOf": [{"maxItems": 0}, {"minItems": 2}],
      "items": {
        "type": "object",
        "required": ["id", "label", "date_from", "date_to"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "date_from": {"type": "string", "format": "date"},
          "date_to": {"type": "string", "format": "date"}
        },
        "additionalProperties": true
      }
    },
    "interpretive_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "label", "effective_date", "official_source_url",
          "before_stratum_id", "after_stratum_id"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "effective_date": {"type": "string", "format": "date"},
          "official_source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "before_stratum_id": {"type": "string", "minLength": 1},
          "after_stratum_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "query_lanes": {"type": "object"},
    "inclusion_rules": {"type": "array"},
    "exclusion_rules": {"type": "array"},
    "materiality_rule": {"type": "string", "minLength": 1},
    "adverse_review": {"type": "object"},
    "contradiction_rule": {"type": "string", "minLength": 1},
    "coverage_expectation": {"type": "string"},
    "maximum_claim_if_incomplete": {"type": "string"},
    "approved_by": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "required": ["interpretive_events"],
        "properties": {"interpretive_events": {"minItems": 1}}
      },
      "then": {
        "required": ["temporal_strata"],
        "properties": {"temporal_strata": {"minItems": 2}}
      }
    }
  ],
  "additionalProperties": true
}
