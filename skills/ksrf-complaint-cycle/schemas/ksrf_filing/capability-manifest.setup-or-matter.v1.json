{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ks-parser.local/schemas/ksrf-filing/capability-manifest.setup-or-matter.v1.json",
  "title": "Манифест возможностей подготовки жалобы в КС РФ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "initial_state",
    "safety",
    "profiles",
    "capabilities"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "initial_state": {"const": "skills_only"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_transmission_default",
        "automatic_installation",
        "automatic_account_creation",
        "secret_values_reported",
        "network_requires_explicit_authorization"
      ],
      "properties": {
        "external_transmission_default": {"const": false},
        "automatic_installation": {"const": false},
        "automatic_account_creation": {"const": false},
        "secret_values_reported": {"const": false},
        "network_requires_explicit_authorization": {"const": true}
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basic", "research", "expert"],
      "properties": {
        "basic": {"$ref": "#/$defs/profile"},
        "research": {"$ref": "#/$defs/profile"},
        "expert": {"$ref": "#/$defs/profile"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "purpose"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "profileRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basic", "research", "expert"],
      "properties": {
        "basic": {"enum": ["required", "optional", "not_used"]},
        "research": {"enum": ["required", "optional", "not_used"]},
        "expert": {"enum": ["required", "optional", "not_used"]}
      }
    },
    "probe": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "executable",
            "service",
            "credential_presence",
            "directory",
            "python_module",
            "renderer",
            "ocr",
            "browser",
            "bounded_network",
            "trusted_approval_verifier",
            "manual",
            "any_of"
          ]
        },
        "executables": {"type": "array", "items": {"type": "string"}},
        "modules": {"type": "array", "items": {"type": "string"}},
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/probe"}
        },
        "paths": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "array", "items": {"type": "string"}},
        "path": {"type": "string"},
        "path_environment": {"type": "string"},
        "verifier_id_environment": {"type": "string"},
        "channel_environment": {"type": "string"},
        "write_required": {"type": "boolean"},
        "require_all": {"type": "boolean"},
        "url": {"type": "string"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "purpose",
        "privacy",
        "cost",
        "dependency",
        "remediation",
        "profiles",
        "dependent_gates",
        "blocking_when_missing",
        "probe"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "privacy": {"type": "string", "minLength": 1},
        "cost": {"type": "string", "minLength": 1},
        "dependency": {"type": "string", "minLength": 1},
        "remediation": {"type": "string", "minLength": 1},
        "profiles": {"$ref": "#/$defs/profileRequirements"},
        "dependent_gates": {"type": "array", "items": {"type": "string"}},
        "blocking_when_missing": {"type": "boolean"},
        "probe": {"$ref": "#/$defs/probe"}
      }
    }
  }
}
