{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ksrf/structured-complaint.schema.json",
  "title": "Structured KSRF Complaint",
  "type": "object",
  "$defs": {
    "canonicalSentenceRole": {
      "enum": ["narrative", "fact", "court_reasoning", "norm_text", "legal_holding", "application_finding", "practice_claim", "adverse_authority", "requested_remedy"]
    }
  },
  "required": ["schema_version", "matter_id", "draft_id", "title", "sections", "sentence_evidence_map", "norm_passport_ids", "issue_option_ids"],
  "properties": {
    "schema_version": {"const": "1.4"},
    "matter_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["code", "heading", "sentences"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "heading": {"type": "string", "minLength": 1},
          "sentences": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "sentence_evidence_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sentence_id", "section_code", "text", "role", "evidence_ids", "support_status"],
        "properties": {
          "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
          "section_code": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "support_status": {"enum": ["pending", "verified", "human_approved", "rejected"]},
          "claim_id": {"type": "string", "minLength": 1},
          "practice_claim_id": {"type": "string", "minLength": 1},
          "issue_option_id": {"type": "string", "minLength": 1},
          "norm_passport_id": {"type": "string", "minLength": 1},
          "application_record_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "application_binding_status": {"enum": ["bound", "unbound"]},
          "application_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "relief_binding_status": {"enum": ["bound", "unbound"]},
          "relief_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "maximum_supported_inference": {"type": "string", "minLength": 1},
          "holding_binding_status": {"enum": ["bound", "unbound"]},
          "holding_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "practice_binding_status": {"enum": ["bound", "unbound"]},
          "practice_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {"properties": {"role": {"const": "requested_remedy"}}, "required": ["role"]},
                {
                  "allOf": [
                    {"properties": {"section_code": {"const": "requested_remedy"}}, "required": ["section_code"]},
                    {"properties": {"role": {"$ref": "#/$defs/canonicalSentenceRole"}}, "required": ["role"]}
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "role": {"const": "requested_remedy"},
                "section_code": {"const": "requested_remedy"}
              },
              "required": ["relief_binding_status"]
            }
          },
          {
            "if": {
              "properties": {"relief_binding_status": {"const": "bound"}},
              "required": ["relief_binding_status"]
            },
            "then": {
              "required": [
                "claim_id",
                "issue_option_id",
                "norm_passport_id",
                "application_record_ids",
                "relief_binding_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "application_finding"}},
              "required": ["role"]
            },
            "then": {
              "required": ["application_binding_status"]
            }
          },
          {
            "if": {
              "properties": {"application_binding_status": {"const": "bound"}},
              "required": ["application_binding_status"]
            },
            "then": {
              "properties": {
                "role": {"const": "application_finding"},
                "evidence_ids": {"minItems": 1}
              },
              "required": [
                "role",
                "claim_id",
                "norm_passport_id",
                "application_record_ids",
                "evidence_ids",
                "maximum_supported_inference",
                "application_binding_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "legal_holding"}},
              "required": ["role"]
            },
            "then": {
              "required": ["holding_binding_status"]
            }
          },
          {
            "if": {
              "properties": {"holding_binding_status": {"const": "bound"}},
              "required": ["holding_binding_status"]
            },
            "then": {
              "properties": {
                "role": {"const": "legal_holding"},
                "evidence_ids": {
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"}
                }
              },
              "required": [
                "role",
                "claim_id",
                "evidence_ids",
                "maximum_supported_inference",
                "holding_binding_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "practice_claim"}},
              "required": ["role"]
            },
            "then": {
              "required": ["practice_binding_status"]
            }
          },
          {
            "if": {
              "properties": {"practice_binding_status": {"const": "bound"}},
              "required": ["practice_binding_status"]
            },
            "then": {
              "properties": {
                "role": {"const": "practice_claim"},
                "evidence_ids": {
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              },
              "required": [
                "role",
                "claim_id",
                "practice_claim_id",
                "issue_option_id",
                "evidence_ids",
                "maximum_supported_inference",
                "practice_binding_sha256"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "norm_passport_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issue_option_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issue_option_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
