{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ksrf/filing-package.schema.json",
  "title": "KSRF Filing Package Manifest",
  "type": "object",
  "required": ["schema_version", "matter_id", "draft_id", "status", "filing_performed", "human_only_actions", "source_versions", "norm_passport_ids", "issue_option_ids", "sentence_evidence_map", "relief_binding_receipts", "relief_binding_index_receipt", "holding_binding_receipts", "holding_binding_index_receipt", "artifacts", "render_qa", "blockers"],
  "$defs": {
    "reliefBindingIndexReceipt": {
      "type": "object",
      "required": ["schema_version", "matter_id", "draft_id", "bindings", "binding_index_sha256", "authority_revision_id", "checked_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "matter_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["sentence_id", "section_code", "role", "relief_binding_sha256"],
            "properties": {
              "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
              "section_code": {"const": "requested_remedy"},
              "role": {"const": "requested_remedy"},
              "relief_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "binding_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority_revision_id": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "sourceEvidenceReceipt": {
      "type": "object",
      "required": ["evidence_id", "claim_id", "norm_id", "norm_version_id", "status", "content_sha256", "verification_revision_id", "verifier_id", "checked_at", "locator", "content_fingerprint"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "norm_id": {"type": "string", "minLength": 1},
        "norm_version_id": {"type": "string", "minLength": 1},
        "status": {"const": "current"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_revision_id": {"type": "string", "minLength": 1},
        "verifier_id": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "locator": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "value": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "content_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "holdingBindingIndexReceipt": {
      "type": "object",
      "required": ["schema_version", "matter_id", "draft_id", "bindings", "binding_index_sha256", "authority_revision_id", "checked_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "matter_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["sentence_id", "section_code", "role", "holding_binding_sha256"],
            "properties": {
              "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
              "section_code": {"type": "string", "minLength": 1},
              "role": {"const": "legal_holding"},
              "holding_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "binding_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority_revision_id": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "holdingSourceEvidenceReceipt": {
      "type": "object",
      "required": ["evidence_id", "source_id", "origin_url", "authority_class", "raw_sha256", "verified_official_locator", "verification_revision_id", "identity_fingerprint", "source_evidence_content_fingerprint"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
        "source_id": {"type": "string", "minLength": 1},
        "origin_url": {"type": "string", "minLength": 1},
        "authority_class": {"enum": ["official_primary", "official_derivative"]},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified_official_locator": {"type": "string", "minLength": 1},
        "verification_revision_id": {"type": "string", "pattern": "^source-verification:sha256:[0-9a-f]{64}$"},
        "identity_fingerprint": {"type": "string", "pattern": "^source-identity:sha256:[0-9a-f]{64}$"},
        "source_evidence_content_fingerprint": {"type": "string", "pattern": "^source-evidence-content:sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "holdingCurrentAuthorityResult": {
      "type": "object",
      "required": ["evidence_id", "filing_ready", "identity_verification_mode", "blockers"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
        "filing_ready": {"const": true},
        "identity_verification_mode": {"enum": ["trusted_derived", "trusted_approval"]},
        "blockers": {"const": []}
      },
      "additionalProperties": false
    },
    "holdingClaimScopeReceipt": {
      "type": "object",
      "required": ["schema_version", "evidence_id", "source_id", "claim_id", "authority_role", "verified_official_locator", "pinpoint", "raw_sha256", "verification_revision_id", "current_evidence_id", "freshness_state", "scope_revision_id", "checked_at", "maximum_supported_inference", "claim_scope_content_fingerprint"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "evidence_id": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
        "source_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "authority_role": {"const": "ksrf_legal_holding"},
        "verified_official_locator": {"type": "string", "minLength": 1},
        "pinpoint": {"type": "string", "minLength": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_revision_id": {"type": "string", "pattern": "^source-verification:sha256:[0-9a-f]{64}$"},
        "current_evidence_id": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
        "freshness_state": {"const": "current"},
        "scope_revision_id": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "maximum_supported_inference": {"type": "string", "minLength": 1},
        "claim_scope_content_fingerprint": {"type": "string", "pattern": "^holding-claim-scope-content:sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "holdingScopeApprovalBindings": {
      "type": "object",
      "required": ["matter_id", "draft_id", "sentence_id", "section_code", "holding_binding_sha256", "claim_id", "evidence_ids", "maximum_supported_inference", "source_ids", "source_evidence_content_fingerprints", "claim_scope_content_fingerprints"],
      "properties": {
        "matter_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
        "section_code": {"type": "string", "minLength": 1},
        "holding_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim_id": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"}
        },
        "maximum_supported_inference": {"type": "string", "minLength": 1},
        "source_ids": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "source_evidence_content_fingerprints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"type": "string", "pattern": "^source-evidence-content:sha256:[0-9a-f]{64}$"}
        },
        "claim_scope_content_fingerprints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"type": "string", "pattern": "^holding-claim-scope-content:sha256:[0-9a-f]{64}$"}
        }
      },
      "additionalProperties": false
    },
    "holdingScopeApprovalRequest": {
      "type": "object",
      "required": ["purpose", "subject_type", "subject_id", "fingerprint", "bindings"],
      "properties": {
        "purpose": {"const": "legal_holding"},
        "subject_type": {"const": "legal_holding_sentence_evidence"},
        "subject_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
        "fingerprint": {"type": "string", "pattern": "^holding-scope-review:sha256:[0-9a-f]{64}$"},
        "bindings": {"$ref": "#/$defs/holdingScopeApprovalBindings"}
      },
      "additionalProperties": false
    },
    "holdingScopeGateReceipt": {
      "type": "object",
      "required": ["schema_version", "passed", "sentence_id", "section_code", "holding_binding_sha256", "claim_id", "evidence_ids", "maximum_supported_inference", "source_ids", "source_evidence_content_fingerprints", "claim_scope_content_fingerprints", "authority_revision_id", "checked_at", "approval_request", "trusted_approval_id"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "passed": {"const": true},
        "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
        "section_code": {"type": "string", "minLength": 1},
        "holding_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim_id": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"}
        },
        "maximum_supported_inference": {"type": "string", "minLength": 1},
        "source_ids": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "source_evidence_content_fingerprints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"type": "string", "pattern": "^source-evidence-content:sha256:[0-9a-f]{64}$"}
        },
        "claim_scope_content_fingerprints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"type": "string", "pattern": "^holding-claim-scope-content:sha256:[0-9a-f]{64}$"}
        },
        "authority_revision_id": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "approval_request": {"$ref": "#/$defs/holdingScopeApprovalRequest"},
        "trusted_approval_id": {"type": "string", "pattern": "^trusted-approval:sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "holdingBindingReceipt": {
      "type": "object",
      "required": ["schema_version", "sentence_id", "section_code", "holding_binding_sha256", "claim_id", "evidence_ids", "maximum_supported_inference", "source_evidence_receipts", "current_authority_results", "claim_scope_receipts", "scope_gate_receipt"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
        "section_code": {"type": "string", "minLength": 1},
        "holding_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim_id": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"}
        },
        "maximum_supported_inference": {"type": "string", "minLength": 1},
        "source_evidence_receipts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"$ref": "#/$defs/holdingSourceEvidenceReceipt"}
        },
        "current_authority_results": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"$ref": "#/$defs/holdingCurrentAuthorityResult"}
        },
        "claim_scope_receipts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^source-evidence:sha256:[0-9a-f]{64}$"},
          "additionalProperties": {"$ref": "#/$defs/holdingClaimScopeReceipt"}
        },
        "scope_gate_receipt": {"$ref": "#/$defs/holdingScopeGateReceipt"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "1.2"},
    "matter_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["blocked", "ready_for_expert_review", "ready_for_human_signing_filing"]},
    "filing_performed": {"const": false},
    "human_only_actions": {
      "type": "array",
      "contains": {"const": "filing"}
    },
    "source_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "norm_passport_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issue_option_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sentence_evidence_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sentence_id", "section_code", "text", "role", "evidence_ids", "support_status"],
        "properties": {
          "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
          "section_code": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "support_status": {"enum": ["pending", "verified", "human_approved", "rejected"]},
          "claim_id": {"type": "string", "minLength": 1},
          "issue_option_id": {"type": "string", "minLength": 1},
          "norm_passport_id": {"type": "string", "minLength": 1},
          "application_record_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "relief_binding_status": {"enum": ["bound", "unbound"]},
          "relief_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "maximum_supported_inference": {"type": "string", "minLength": 1},
          "holding_binding_status": {"enum": ["bound", "unbound"]},
          "holding_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {"properties": {"role": {"const": "requested_remedy"}}, "required": ["role"]},
                {"properties": {"section_code": {"const": "requested_remedy"}}, "required": ["section_code"]}
              ]
            },
            "then": {
              "properties": {
                "role": {"const": "requested_remedy"},
                "section_code": {"const": "requested_remedy"}
              },
              "required": ["relief_binding_status"]
            }
          },
          {
            "if": {
              "properties": {"relief_binding_status": {"const": "bound"}},
              "required": ["relief_binding_status"]
            },
            "then": {
              "properties": {"evidence_ids": {"minItems": 1}},
              "required": ["claim_id", "issue_option_id", "norm_passport_id", "application_record_ids", "relief_binding_sha256"]
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "legal_holding"}},
              "required": ["role"]
            },
            "then": {
              "required": ["holding_binding_status"]
            }
          },
          {
            "if": {
              "properties": {"holding_binding_status": {"const": "bound"}},
              "required": ["holding_binding_status"]
            },
            "then": {
              "properties": {
                "role": {"const": "legal_holding"},
                "evidence_ids": {
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^source-evidence:sha256:[0-9a-f]{64}$"}
                }
              },
              "required": ["role", "claim_id", "evidence_ids", "maximum_supported_inference", "holding_binding_sha256"]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "relief_binding_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "sentence_id", "relief_binding_sha256", "claim_id", "issue_option_id", "issue_content_fingerprint", "norm_passport_id", "norm_passport_content_fingerprint", "application_record_content_fingerprints", "evidence_ids", "source_evidence_revision_ids", "source_evidence_receipts", "trusted_approval_ids", "approval_request_fingerprints", "binding_index_receipt"],
        "properties": {
          "schema_version": {"const": "1.1.0"},
          "sentence_id": {"type": "string", "pattern": "^sent-[0-9a-f]{16}$"},
          "relief_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "claim_id": {"type": "string", "minLength": 1},
          "issue_option_id": {"type": "string", "minLength": 1},
          "issue_content_fingerprint": {"type": "string", "minLength": 1},
          "norm_passport_id": {"type": "string", "minLength": 1},
          "norm_passport_content_fingerprint": {"type": "string", "minLength": 1},
          "application_record_content_fingerprints": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_evidence_revision_ids": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "source_evidence_receipts": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/sourceEvidenceReceipt"}
          },
          "binding_index_receipt": {"$ref": "#/$defs/reliefBindingIndexReceipt"},
          "trusted_approval_ids": {
            "type": "object",
            "required": ["issue", "norm_version", "application"],
            "properties": {
              "issue": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              },
              "norm_version": {"type": "string", "minLength": 1},
              "application": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          },
          "approval_request_fingerprints": {
            "type": "object",
            "required": ["issue", "norm_version", "application", "preservation"],
            "properties": {
              "issue": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              },
              "norm_version": {"type": "string", "minLength": 1},
              "application": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              },
              "preservation": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "relief_binding_index_receipt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reliefBindingIndexReceipt"}
      ]
    },
    "holding_binding_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/holdingBindingReceipt"}
    },
    "holding_binding_index_receipt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/holdingBindingIndexReceipt"}
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "mime_type", "size", "sha256", "renderer", "renderer_version", "status"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["complete", "failed", "blocked"]}
        },
        "additionalProperties": true
      }
    },
    "render_qa": {"type": "object", "required": ["passed"]},
    "release_approval": {
      "allOf": [
        {"$ref": "https://example.local/ksrf/trusted-approval-reference.v1.schema.json"},
        {
          "type": "object",
          "required": ["status", "basis_sha256"],
          "properties": {
            "status": {"const": "approved"},
            "basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "approval_request": {
              "properties": {
                "purpose": {"const": "release"},
                "subject_type": {"const": "filing_release_pack"}
              }
            },
            "reviewer": {
              "type": ["string", "null"],
              "description": "Display-only reviewer name copied from the validated ledger record."
            },
            "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
            "raw_reviewer_diagnostic": {
              "type": ["string", "null"],
              "description": "Caller-supplied diagnostic value; never approval authority."
            },
            "raw_reviewed_at_diagnostic": {
              "type": ["string", "null"],
              "description": "Caller-supplied diagnostic value; never approval authority."
            }
          }
        }
      ]
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["ready_for_expert_review", "ready_for_human_signing_filing"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "source_versions": {"minItems": 1},
          "norm_passport_ids": {"minItems": 1},
          "issue_option_ids": {"minItems": 1},
          "relief_binding_receipts": {"minItems": 1},
          "relief_binding_index_receipt": {"$ref": "#/$defs/reliefBindingIndexReceipt"},
          "holding_binding_index_receipt": {"$ref": "#/$defs/holdingBindingIndexReceipt"},
          "sentence_evidence_map": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "role": {"const": "requested_remedy"},
                "relief_binding_status": {"const": "bound"}
              },
