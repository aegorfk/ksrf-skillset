{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aegorfk/ksrf-skillset/schemas/practice-analysis.v1.json",
  "title": "PracticeAnalysisGate and PracticeClaimLedger v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/practice_analysis_gate"},
    {"$ref": "#/$defs/claim_revision"},
    {"$ref": "#/$defs/ledger_event"},
    {"$ref": "#/$defs/practice_request_v2"},
    {"$ref": "#/$defs/practice_result_v2"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_state": {
      "type": "string",
      "enum": [
        "not_required",
        "required",
        "running",
        "blocked",
        "ready",
        "stale"
      ]
    },
    "stage": {
      "type": "string",
      "enum": ["options", "drafting", "qa", "filing"]
    },
    "claim_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_sha256", "source_locator"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_sha256": {"$ref": "#/$defs/sha256"},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "trigger_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "dimension", "match", "start", "end"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "dimension": {
          "type": "string",
          "enum": [
            "repeatability",
            "split",
            "temporal",
            "cross_circuit",
            "systemic",
            "quantitative",
            "judicial_meaning"
          ]
        },
        "match": {"type": "string", "minLength": 1},
        "start": {"type": ["integer", "null"], "minimum": 0},
        "end": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "claim_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "case_id",
        "claim_id",
        "revision_id",
        "claim_sha256",
        "claim_text",
        "source",
        "empirical_dimensions",
        "trigger_evidence",
        "analysis_route",
        "bindings",
        "created_at",
        "ledger_id",
        "sequence",
        "previous_event_sha256",
        "event_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "claim_revision"},
        "case_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "revision_id": {"$ref": "#/$defs/sha256"},
        "claim_sha256": {"$ref": "#/$defs/sha256"},
        "claim_text": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "locator", "context_sha256", "source_file_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "format": {"type": "string", "enum": ["json", "txt", "md", "docx"]},
            "locator": {"type": "string", "minLength": 1},
            "context_sha256": {"$ref": "#/$defs/sha256"},
            "source_file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "empirical_dimensions": {
          "type": "array",
          "items": {"$ref": "#/$defs/trigger_evidence/properties/dimension"},
          "uniqueItems": true
        },
        "trigger_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/trigger_evidence"}
        },
        "analysis_route": {
          "type": "string",
          "enum": [
            "single_case_meaning",
            "cassation_corpus",
            "higher_court_authority",
            "non_judicial_empirical"
          ]
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_dependency_ids",
            "case_dependency_sha256",
            "hypothesis_sha256"
          ],
          "properties": {
            "case_dependency_ids": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            },
            "case_dependency_sha256": {"$ref": "#/$defs/sha256"},
            "hypothesis_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "hypothesis_ids": {"type": "array", "items": {"type": "string"}},
        "option_ids": {"type": "array", "items": {"type": "string"}},
        "norm_refs": {"type": "array", "items": {"type": "string"}},
        "practice_dependency_explicit": {"type": ["boolean", "null"]},
        "research_question": {"type": ["string", "null"]},
        "supersedes_revision_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "created_at": {"type": "string", "minLength": 1},
        "ledger_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "previous_event_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "event_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "revision_id",
        "claim_sha256",
        "source_locator",
        "state",
        "draft_blocked",
        "blocking_reasons",
        "next_actions",
        "source_file_sha256",
        "input_bindings_sha256",
        "input_manifest_updated_at",
        "claim_created_at",
        "wording_review_event_sha256",
        "wording_reviewed_at",
        "result_import_event_sha256",
        "expected_finalization_receipt_sha256",
        "result_imported_at",
        "result_source_sha256",
        "result_created_at",
        "attachment_event_sha256",
        "attachment_attached_at",
        "anchor_checked_at",
        "trust_anchor_sha256"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "revision_id": {"$ref": "#/$defs/sha256"},
        "claim_sha256": {"$ref": "#/$defs/sha256"},
        "source_locator": {"type": "string", "minLength": 1},
        "source_file_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_bindings_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_manifest_updated_at": {"type": ["string", "null"]},
        "claim_created_at": {"type": ["string", "null"]},
        "state": {"$ref": "#/$defs/claim_state"},
        "draft_blocked": {"type": "boolean"},
        "blocking_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "next_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "request_id": {"type": ["string", "null"]},
        "handoff_id": {"type": ["string", "null"]},
        "maximum_permitted_claim": {"type": ["string", "null"]}
        ,"hypothesis_ids": {"type": "array", "items": {"type": "string"}}
        ,"option_ids": {"type": "array", "items": {"type": "string"}}
        ,"empirical_dimensions": {"type": "array", "items": {"type": "string"}}
        ,"analysis_route": {"type": ["string", "null"]}
        ,"plan_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"fingerprint_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"wording_review_event_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"wording_reviewed_at": {"type": ["string", "null"]}
        ,"result_import_event_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"expected_finalization_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"result_imported_at": {"type": ["string", "null"]}
        ,"result_source_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"result_created_at": {"type": ["string", "null"]}
        ,"attachment_event_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"attachment_attached_at": {"type": ["string", "null"]}
        ,"anchor_checked_at": {"type": ["string", "null"]}
        ,"trust_anchor_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        ,"wording_review": {"type": ["object", "null"]}
      }
    },
    "practice_analysis_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "generated_at",
        "stage",
        "input_bindings",
        "counts_by_state",
        "claims",
        "stage_verdict",
        "blocked_claim_ids",
        "allowed_claim_ids",
        "unaffected_claim_ids",
        "global_integrity_errors",
        "prefiling_refresh"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "case_id": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "stage": {"$ref": "#/$defs/stage"},
        "input_bindings": {"type": "object"},
        "counts_by_state": {
          "type": "object",
          "required": [
            "not_required",
            "required",
            "running",
            "blocked",
            "ready",
            "stale"
          ],
          "additionalProperties": false,
          "properties": {
            "not_required": {"type": "integer", "minimum": 0},
            "required": {"type": "integer", "minimum": 0},
            "running": {"type": "integer", "minimum": 0},
            "blocked": {"type": "integer", "minimum": 0},
            "ready": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0}
          }
        },
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/gate_claim"}
        },
        "stage_verdict": {
          "type": "string",
          "enum": ["ready", "partial", "blocked"]
        },
        "blocked_claim_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_claim_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "unaffected_claim_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "global_integrity_errors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "prefiling_refresh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "valid", "record", "ready_claim_set_sha256"],
          "properties": {
            "required": {"type": "boolean"},
            "valid": {"type": "boolean"},
            "record": {"type": ["object", "null"]},
            "ready_claim_set_sha256": {
              "oneOf": [
                {"$ref": "#/$defs/sha256"},
                {"type": "null"}
              ]
            }
          }
        }
      }
    },
    "practice_request_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "handoff_id",
        "created_at",
        "source_skill",
        "target_skill",
        "run_id",
        "plan_sha256",
        "evidence_sha256",
        "payload_type",
        "payload",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "handoff_id": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "minLength": 1},
        "source_skill": {"const": "ksrf-complaint-cycle"},
        "target_skill": {"const": "ksrf-cassation-judicial-meaning"},
        "run_id": {"type": "string", "minLength": 1},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "payload_type": {"const": "unproven_research_questions"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "questions",
            "claim_bindings",
            "claim_set_sha256",
            "request_sha256",
            "drafting_ready"
          ],
          "properties": {
            "questions": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "claim_bindings": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/claim_binding"}
            },
            "claim_questions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim_id",
                  "question_id",
                  "question",
                  "disconfirmation_prompts"
                ],
                "properties": {
                  "claim_id": {"type": "string", "minLength": 1},
                  "question_id": {"$ref": "#/$defs/sha256"},
                  "question": {"type": "string", "minLength": 1},
                  "disconfirmation_prompts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            },
            "claim_set_sha256": {"$ref": "#/$defs/sha256"},
            "request_sha256": {"$ref": "#/$defs/sha256"},
            "drafting_ready": {"const": false}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "manifest_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "present", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "present": {"const": true},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "quality_binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quality_type", "artifact_sha256", "artifact"],
          "properties": {
            "quality_type": {
              "enum": [
                "chain_stage_propagation",
                "uncertainty_profile",
                "coding_audit_plan",
                "coding_reliability",
                "prefiling_refresh"
              ]
            },
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "artifact": {"type": "object", "minProperties": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quality_type",
            "artifact_sha256",
            "artifact",
            "expected_receipt_sha256"
          ],
          "properties": {
            "quality_type": {"const": "coding_audit_finalization_receipt"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "artifact": {"type": "object", "minProperties": 1},
            "expected_receipt_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "practice_result_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "handoff_id",
        "created_at",
        "source_skill",
        "target_skill",
        "run_id",
        "plan_sha256",
        "evidence_sha256",
        "fingerprint_sha256",
        "payload_type",
        "payload",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "handoff_id": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "minLength": 1},
        "source_skill": {"const": "ksrf-cassation-judicial-meaning"},
        "target_skill": {"const": "ksrf-complaint-cycle"},
        "run_id": {"type": "string", "minLength": 1},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "payload_type": {
          "type": "string",
          "enum": ["approved_bounded_findings", "authority_cards"]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_handoff_id",
            "request_sha256",
            "claim_set_sha256",
            "claim_bindings",
            "findings",
            "approval_binding",
            "artifact_manifest",
            "selected_position_set_sha256",
            "selected_proofs",
            "maximum_permitted_claim",
            "limitations"
            ,"quality_bindings"
            ,"drafting_ready"
            ,"supporting_position_card_ids"
            ,"adverse_position_card_ids"
          ],
          "properties": {
            "request_handoff_id": {"$ref": "#/$defs/sha256"},
            "request_sha256": {"$ref": "#/$defs/sha256"},
            "claim_set_sha256": {"$ref": "#/$defs/sha256"},
            "claim_bindings": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/claim_binding"}
            },
            "drafting_ready": {"const": true},
            "supporting_position_card_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "adverse_position_card_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["finding_id", "candidate_id", "candidate_sha256", "candidate", "claim_ids", "claim_wording", "supporting_position_card_ids", "adverse_position_card_ids", "maximum_permitted_claim"],
                "properties": {
                  "finding_id": {"$ref": "#/$defs/sha256"},
                  "candidate_id": {"type": "string", "minLength": 1},
                  "candidate_sha256": {"$ref": "#/$defs/sha256"},
                  "candidate": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["candidate_id", "plan_sha256", "maximum_permitted_claim", "human_review", "drafting_ready"],
                    "properties": {
                      "candidate_id": {"type": "string", "minLength": 1},
                      "plan_sha256": {"$ref": "#/$defs/sha256"},
                      "claim_wording": {"type": "string", "minLength": 1},
                      "observed_statement": {"type": "string", "minLength": 1},
                      "normative_defect_bridge": {"type": "string", "minLength": 1},
                      "maximum_permitted_claim": {"type": "string", "minLength": 1},
                      "supporting_position_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
                      "adverse_position_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
                      "human_review": {"const": "approved"},
                      "drafting_ready": {"const": true}
                    },
                    "anyOf": [
                      {"required": ["claim_wording"]},
                      {"required": ["observed_statement", "normative_defect_bridge"]}
                    ]
                  },
                  "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "claim_wording": {"type": "string", "minLength": 1},
                  "supporting_position_card_ids": {"type": "array", "items": {"type": "string"}},
                  "adverse_position_card_ids": {"type": "array", "items": {"type": "string"}},
                  "maximum_permitted_claim": {"type": "string", "minLength": 1}
                }
              }
            },
            "approval_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "human_decision_sha256",
                "validation_report_sha256",
                "normative_bridge_sha256",
                "reviewer",
                "approved_at"
              ],
              "properties": {
                "human_decision_sha256": {"$ref": "#/$defs/sha256"},
                "validation_report_sha256": {"$ref": "#/$defs/sha256"},
                "normative_bridge_sha256": {"$ref": "#/$defs/sha256"},
                "reviewer": {"type": "string", "minLength": 1},
                "approved_at": {"type": "string", "minLength": 1}
              }
            },
            "artifact_manifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["files", "manifest_sha256"],
              "properties": {
                "files": {
                  "type": "array",
                  "minItems": 7,
                  "items": {"$ref": "#/$defs/manifest_file"}
                },
                "manifest_sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "selected_position_set_sha256": {"$ref": "#/$defs/sha256"},
            "selected_proofs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "position_cards",
                "comparisons",
                "relations",
                "adverse",
                "bridge",
                "human_decision",
                "validation_report"
              ],
              "properties": {
                "position_cards": {"type": "array", "minItems": 1, "items": {"type": "object"}},
                "comparisons": {"type": "array", "minItems": 1, "items": {"type": "object"}},
                "relations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
                "adverse": {"type": "object"},
                "bridge": {"type": "object"},
                "human_decision": {"type": "object"},
                "validation_report": {"type": "object"}
              }
            },
            "maximum_permitted_claim": {"type": "string", "minLength": 1},
            "quality_bindings": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/quality_binding"},
              "allOf": [
                {"contains": {"properties": {"quality_type": {"const": "chain_stage_propagation"}}, "required": ["quality_type"]}, "minContains": 1, "maxContains": 1},
                {"contains": {"properties": {"quality_type": {"const": "uncertainty_profile"}}, "required": ["quality_type"]}, "minContains": 1, "maxContains": 1},
                {"contains": {"properties": {"quality_type": {"const": "coding_audit_plan"}}, "required": ["quality_type"]}, "minContains": 1, "maxContains": 1},
                {"contains": {"properties": {"quality_type": {"const": "coding_reliability"}}, "required": ["quality_type"]}, "minContains": 1, "maxContains": 1},
                {"contains": {"properties": {"quality_type": {"const": "coding_audit_finalization_receipt"}}, "required": ["quality_type"]}, "minContains": 1, "maxContains": 1},
                {"contains": {"properties": {"quality_type": {"const": "prefiling_refresh"}}, "required": ["quality_type"]}, "minContains": 1, "maxContains": 1}
              ]
            },
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ready_claim_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "revision_id", "claim_sha256", "source_file_sha256",
        "input_bindings_sha256", "input_manifest_updated_at", "claim_created_at",
        "handoff_id", "plan_sha256",
        "evidence_sha256", "fingerprint_sha256", "maximum_permitted_claim",
        "wording_review_event_sha256", "wording_reviewed_at",
        "result_import_event_sha256", "expected_finalization_receipt_sha256", "result_imported_at", "result_source_sha256",
        "result_created_at", "attachment_event_sha256", "attachment_attached_at",
        "anchor_checked_at", "trust_anchor_sha256"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "revision_id": {"$ref": "#/$defs/sha256"},
        "claim_sha256": {"$ref": "#/$defs/sha256"},
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "input_bindings_sha256": {"$ref": "#/$defs/sha256"},
